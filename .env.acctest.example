# Copy to .env.acctest (gitignored) and fill in a SANDBOX Klaviyo key.
#
# The acceptance suite creates and destroys real objects (a list and
# draft flows, all named tfacc-*). Point it at a sandbox account, not
# the production aroma-zone account.
#
#   set -a; . .env.acctest; set +a; make testacc
KLAVIYO_API_KEY=pk_replace_me
# Optional: override the pinned revision or the API host.
# KLAVIYO_API_REVISION=2026-04-15.pre
# KLAVIYO_BASE_URL=https://a.klaviyo.com
